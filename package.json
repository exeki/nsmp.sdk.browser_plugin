{
  "name": "nsmp.sdk.browser_plugin",
  "description": "Browser extension for NSMP SDK",
  "private": true,
  "version": "0.5.1",
  "type": "module",
  "scripts": {
    "dev": "wxt -p 3000",
    "dev:firefox": "wxt -b firefox -p 3001",
    "dev:safari": "wxt -b safari -p 3002",
    "build": "wxt build",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:safari": "wxt zip -b safari",
    "compile": "vue-tsc --noEmit",
    "icons:generate": "node scripts/generate-icons.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@css-render/vue3-ssr": "^0.15.14",
    "naive-ui": "^2.44.1",
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@wxt-dev/module-vue": "^1.0.3",
    "sharp": "^0.35.2",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.5",
    "wxt": "^0.20.26"
  }
}
